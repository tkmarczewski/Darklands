<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2A1A00"/>
            <stroke android:width="1dp" android:color="@color/grimGold"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#1A1200"/>
            <stroke android:width="1dp" android:color="#5C4A00"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>
</selector>
