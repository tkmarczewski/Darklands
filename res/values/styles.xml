<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GrimReich" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/grimBg</item>
        <item name="android:textColor">@color/grimParchment</item>
        <item name="colorPrimary">@color/grimAccent</item>
        <item name="colorPrimaryDark">@color/grimBgDark</item>
        <item name="colorAccent">@color/grimGold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!-- Przycisk nawigacyjny dolny (6 przycisków hub) -->
    <style name="GrimNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimParchment</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
    </style>

    <!-- Przycisk regionu (lista w Atłasie) -->
    <style name="GrimRegionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/btn_region_bg</item>
        <item name="android:textColor">@color/grimParchment</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
    </style>

    <!-- Przyciski akcji walki -->
    <style name="GrimCombatButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimParchment</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Mały przycisk w kartach postaci -->
    <style name="GrimSmallButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimParchment</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Przycisk Wróć -->
    <style name="GrimBackButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/grimBgDark</item>
        <item name="android:textColor">@color/grimGold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
