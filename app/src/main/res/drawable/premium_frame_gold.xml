<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Inner Dark Background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grimBgUltraDark" />
        </shape>
    </item>
    <!-- Thick Border (Patina) -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/grimPatina" />
        </shape>
    </item>
    <!-- Thin Outer Gold Border -->
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/grimGoldDark" />
        </shape>
    </item>
</layer-list>
