<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgUltraDark"
    android:fillViewport="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/ivMainMenuLogo"
                android:layout_width="320dp"
                android:layout_height="180dp"
                android:src="@drawable/logo_grimreich_full"
                android:scaleType="fitCenter"
                android:layout_marginBottom="16dp"
                android:contentDescription="GrimReich Logo" />

            <!-- HORIZONTAL BUTTON ROW -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnNewGame"
                    style="@style/GrimCombatButton"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:text="NOWA GRA" />

                <Button
                    android:id="@+id/btnContinue"
                    style="@style/GrimCombatButton"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:text="KONTYNUACJA" />

                <Button
                    android:id="@+id/btnExit"
                    style="@style/GrimCombatButton"
                    android:layout_width="200dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="8dp"
                    android:text="WYJŚCIE" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvDevMenuTrigger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:padding="24dp"
            android:text="DEV"
            android:textColor="@color/grimTextMuted"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true" />

    </RelativeLayout>
</ScrollView>
