<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgUltraDark"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="64dp"
            android:paddingBottom="64dp">

        <ImageView
            android:id="@+id/ivMainMenuLogo"
            android:layout_width="400dp"
            android:layout_height="250dp"
            android:src="@drawable/logo_grimreich_full"
            android:scaleType="fitCenter"
            android:layout_marginBottom="48dp"
            android:contentDescription="GrimReich Logo" />

        <Button
            android:id="@+id/btnNewGame"
            style="@style/GrimCombatButton"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:text="NOWA GRA" />

        <Button
            android:id="@+id/btnContinue"
            style="@style/GrimCombatButton"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="KONTYNUACJA" />

        <Button
            android:id="@+id/btnExit"
            style="@style/GrimCombatButton"
            android:layout_width="280dp"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="WYJŚCIE" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvDevMenuTrigger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:padding="16dp"
        android:text="DEV"
        android:textColor="@color/grimTextMuted"
        android:textSize="10sp"
        android:clickable="true"
        android:focusable="true" />

    </FrameLayout>
</ScrollView>
