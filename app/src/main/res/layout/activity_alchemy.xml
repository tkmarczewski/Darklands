<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">
    <TextView android:id="@+id/tvAlchemy" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fontFamily="monospace" android:textColor="#c8a96e" android:textSize="13sp"/>
    <EditText android:id="@+id/etRecipeIndex" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Numer receptury" android:inputType="number" android:textColor="#c8a96e"/>
    <Button android:id="@+id/btnBrew" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Warz miksture"/>
    <Button android:id="@+id/btnBackAlchemy" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="POWRÓT"/>
    <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#a0e8a0" android:textSize="13sp"/>
</LinearLayout>
