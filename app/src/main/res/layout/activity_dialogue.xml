<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvNpcName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="NPC Name"
        android:textColor="#e63946"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvNpcRole"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Role"
        android:textColor="#c8a96e"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvDialogueText"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Dialogue content..."
        android:textColor="#ffffff"
        android:textSize="16sp"
        android:fontFamily="serif"
        android:padding="8dp"
        android:background="#16213e" />

    <LinearLayout
        android:id="@+id/choicesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="24dp" />

</LinearLayout>
