<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBg">

    <!-- STATUS BAR -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/grimBgDark"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tvDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dzień 1"
            android:textColor="@color/grimParchment"
            android:fontFamily="serif"
            android:textSize="12sp"/>

        <TextView android:id="@+id/tvRegion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Wybrzeże Północne"
            android:textColor="@color/grimParchment"
            android:gravity="center"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:textSize="12sp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="end">

            <TextView android:id="@+id/tvGold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Złoto: 0"
                android:textColor="@color/grimGold"
                android:textSize="11sp"/>

            <TextView android:id="@+id/tvFenomen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mgła"
                android:textColor="@color/grimMist"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- PASEK FENOMENÓW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A0A00"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="☁ Mgła"
            android:textColor="@color/grimMist"
            android:textSize="10sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🩸 Krew"
            android:textColor="@color/grimBlood"
            android:textSize="10sp"
            android:gravity="center"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🪞 Odbicie"
            android:textColor="@color/grimReflection"
            android:textSize="10sp"
            android:gravity="center"/>
    </LinearLayout>

    <!-- LOG WYDARZEŃ -->
    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:fadeScrollbars="true">

        <TextView android:id="@+id/tvLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grimParchment"
            android:fontFamily="serif"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:text="Kroniki GrimReich..."/>
    </ScrollView>

    <!-- PARTY STRIP -->
    <include layout="@layout/strip_party"/>

    <!-- NAWIGACJA DOLNA 3x2 -->
    <GridLayout
        android:id="@+id/navGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="2"
        android:background="@color/grimBgDark"
        android:padding="4dp">

        <Button android:id="@+id/btnCity"
            style="@style/GrimNavButton"
            android:text="Osada"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

        <Button android:id="@+id/btnTravel"
            style="@style/GrimNavButton"
            android:text="Podróż"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

        <Button android:id="@+id/btnInventory"
            style="@style/GrimNavButton"
            android:text="Ekwipunek"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

        <Button android:id="@+id/btnShrine"
            style="@style/GrimNavButton"
            android:text="Kaplica"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

        <Button android:id="@+id/btnAlchemy"
            style="@style/GrimNavButton"
            android:text="Alchemia"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

        <Button android:id="@+id/btnMap"
            style="@style/GrimNavButton"
            android:text="Atlas"
            android:drawableTop="@drawable/ic_nav_placeholder"
            android:layout_columnWeight="1"
            android:layout_rowWeight="1"/>

    </GridLayout>
</LinearLayout>
