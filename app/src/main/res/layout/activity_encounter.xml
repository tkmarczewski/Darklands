<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvEncounterTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zdarzenie"
        android:textColor="#e63946"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvEncounterDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Opis zdarzenia..."
        android:textColor="#c8a96e"
        android:textSize="14sp"
        android:fontFamily="serif"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:id="@+id/choicesContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvEncounterResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#a0e8a0"
        android:textSize="14sp"
        android:layout_marginTop="24dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btnEncounterClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Kontynuuj podróż"
        android:visibility="gone"
        android:layout_marginTop="16dp" />

</LinearLayout>
