<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A000000"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvTavernTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="KARCZMA POD PĘKNIĘTYM KUFLEM"
        android:textColor="#C8A96E"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <Button
                android:id="@+id/btnRest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ODPOCZYNEK (50 G)"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnGossip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SŁUCHAJ PLOTEK"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnHire"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SZUKAJ KOMPANÓW"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:background="#40000000"
            android:padding="12dp">
            <TextView
                android:id="@+id/tvTavernLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Karczmarz poleruje blat brudną szmatą..."
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:fontFamily="serif" />
        </ScrollView>
    </LinearLayout>

    <Button
        android:id="@+id/btnExitTavern"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ODEJDŹ OD LADY"
        android:layout_marginTop="16dp" />

</LinearLayout>
