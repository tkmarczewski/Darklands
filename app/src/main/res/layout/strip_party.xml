<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#22000000"
    android:orientation="horizontal"
    android:padding="4dp">

    <!-- Char Slot Template with Portrait -->
    <LinearLayout
        android:id="@+id/charSlot0"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#80000000"
        android:layout_marginEnd="4dp">

        <ImageView
            android:id="@+id/ivChar0Portrait"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            android:src="@drawable/port_knight"
            android:background="#20FFFFFF"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <TextView android:id="@+id/tvChar0Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ralwing"
                android:textColor="@color/grimParchment"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="monospace"/>

            <ProgressBar android:id="@+id/pbChar0HP"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="4dp"
                android:progressTint="@color/grimBlood"
                android:progressBackgroundTint="#330000"
                android:progress="100" android:max="100"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Slot 1 -->
    <LinearLayout
        android:id="@+id/charSlot1"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#80000000"
        android:layout_marginEnd="4dp"
        android:visibility="invisible">
        <ImageView android:id="@+id/ivChar1Portrait" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvChar1Name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/GrimTextSmall" />
            <ProgressBar android:id="@+id/pbChar1HP" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Slot 2 -->
    <LinearLayout
        android:id="@+id/charSlot2"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#80000000"
        android:layout_marginEnd="4dp"
        android:visibility="invisible">
        <ImageView android:id="@+id/ivChar2Portrait" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvChar2Name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/GrimTextSmall" />
            <ProgressBar android:id="@+id/pbChar2HP" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Slot 3 -->
    <LinearLayout
        android:id="@+id/charSlot3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="4dp"
        android:background="#80000000"
        android:visibility="invisible">
        <ImageView android:id="@+id/ivChar3Portrait" android:layout_width="64dp" android:layout_height="64dp" android:scaleType="centerCrop" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
            <TextView android:id="@+id/tvChar3Name" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/GrimTextSmall" />
            <ProgressBar android:id="@+id/pbChar3HP" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
