<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#c8a96e"
            android:textSize="14sp"
            android:paddingBottom="16dp" />

        <Button
            android:id="@+id/btnBootstrap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bootstrap MVP" />

        <Button
            android:id="@+id/btnCity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Show City" />

        <Button
            android:id="@+id/btnAcceptQuest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Accept First Quest" />

        <Button
            android:id="@+id/btnTravel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Travel To Quest" />

        <Button
            android:id="@+id/btnResolve"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Resolve Quest" />

        <Button
            android:id="@+id/btnJournal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Journal" />

    </LinearLayout>
</ScrollView>