<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivHubBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_party_castle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Minimal Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="#D0000000">

            <TextView
                android:id="@+id/tvTime"
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/app_name"
                android:textSize="14sp"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvDevMenuTrigger"
                style="@style/GrimTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="12dp"
                android:text="DEV"
                android:textColor="@color/grimGold"
                android:fontFamily="monospace"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="12dp">

            <GridLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.6"
                android:columnCount="3"
                android:background="#80000000"
                android:padding="8dp">

                <Button android:id="@+id/openCity" style="@style/GrimCombatButton" android:text="@string/menu_city" android:fontFamily="monospace" />
                <Button android:id="@+id/openMap" style="@style/GrimCombatButton" android:text="@string/menu_map" android:fontFamily="monospace" />
                <Button android:id="@+id/openInventory" style="@style/GrimCombatButton" android:text="@string/menu_backpack" android:fontFamily="monospace" />

                <Button android:id="@+id/openQuests" style="@style/GrimCombatButton" android:text="@string/menu_quests" android:fontFamily="monospace" />
                <Button android:id="@+id/openReputation" style="@style/GrimCombatButton" android:text="@string/menu_reputation" android:fontFamily="monospace" />
                <Button android:id="@+id/openSaints" style="@style/GrimCombatButton" android:text="@string/menu_saints" android:fontFamily="monospace" />

                <Button android:id="@+id/openCityEvents" style="@style/GrimCombatButton" android:text="@string/menu_news" android:fontFamily="monospace" />
                <Button android:id="@+id/openTransfer" style="@style/GrimCombatButton" android:text="@string/menu_transfer" android:fontFamily="monospace" />
                <Button android:id="@+id/openFinale" style="@style/GrimCombatButton" android:text="@string/menu_finale" android:fontFamily="monospace" android:visibility="gone" />

                <Button android:id="@+id/openCombatStatus" style="@style/GrimCombatButton" android:text="@string/menu_combat" android:fontFamily="monospace" android:visibility="gone" />
            </GridLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ZADANIA TERENOWE"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <!-- FIELD QUESTS AREA -->
                <LinearLayout
                    android:id="@+id/fieldQuestContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#20FFFFFF"
                    android:padding="4dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvLogMini"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="#40000000"
                    android:padding="12dp"
                    android:text="Kroniki pękniętego świata..."
                    android:textColor="@color/grimGold"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </LinearLayout>

        <include layout="@layout/strip_party" />

    </LinearLayout>

    <com.grimreich.ui.view.GlitchOverlayView
        android:id="@+id/glitchOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
