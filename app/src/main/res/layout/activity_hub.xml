<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- BACKGROUND: The Party at the Castle -->
    <ImageView
        android:id="@+id/ivHubBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_party_castle" />

    <!-- OVERLAY FOR BETTER TEXT READABILITY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grimParchment"
            android:fontFamily="serif"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:columnCount="4"
            android:rowCount="3"
            android:alignmentMode="alignMargins"
            android:columnOrderPreserved="false">

            <Button android:id="@+id/openCity" style="@style/GrimNavButton" android:text="Miasto" />
            <Button android:id="@+id/openMap" style="@style/GrimNavButton" android:text="Mapa" />
            <Button android:id="@+id/openInventory" style="@style/GrimNavButton" android:text="Plecak" />
            <Button android:id="@+id/openTrade" style="@style/GrimNavButton" android:text="Handel" />

            <Button android:id="@+id/openSaints" style="@style/GrimNavButton" android:text="Prorocy" />
            <Button android:id="@+id/openQuests" style="@style/GrimNavButton" android:text="Zadania" />
            <Button android:id="@+id/openCombatStatus" style="@style/GrimNavButton" android:text="Walka" />
            <Button android:id="@+id/openCityEvents" style="@style/GrimNavButton" android:text="Wieści" />

            <!-- Empty space or more buttons -->
            <Button android:id="@+id/openReputation" style="@style/GrimNavButton" android:text="Reputacja" />
            <Button android:id="@+id/openTransfer" style="@style/GrimNavButton" android:text="Transfer" />
            <Button android:id="@+id/openFinale" style="@style/GrimNavButton" android:text="FINAŁ" />

        </GridLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">
            <Button android:id="@+id/btnSave" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zapisz" android:layout_marginEnd="8dp" />
            <Button android:id="@+id/btnLoad" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wczytaj" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
