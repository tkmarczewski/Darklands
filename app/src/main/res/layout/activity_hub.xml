<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- CANONICAL BACKGROUND -->
    <ImageView
        android:id="@+id/ivHubBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_party_castle" />

    <!-- OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#A0000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header - Modernized -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#80000000">

            <TextView
                android:id="@+id/tvTime"
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="Grimhold | Dzień 1 | Poranek"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvDevMenuTrigger"
                style="@style/GrimTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="DEV"
                android:clickable="true"
                android:focusable="true" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- NAVIGATION GRID -->
            <GridLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:columnCount="3"
                android:rowCount="4"
                android:background="#60000000"
                android:padding="8dp">

                <Button android:id="@+id/openCity" style="@style/GrimCombatButton" android:text="MIASTO" />
                <Button android:id="@+id/openMap" style="@style/GrimCombatButton" android:text="MAPA" />
                <Button android:id="@+id/openInventory" style="@style/GrimCombatButton" android:text="PLECAK" />

                <Button android:id="@+id/openQuests" style="@style/GrimCombatButton" android:text="ZADANIA" />
                <Button android:id="@+id/openSaints" style="@style/GrimCombatButton" android:text="KAPLICA" />
                <Button android:id="@+id/openReputation" style="@style/GrimCombatButton" android:text="REPUTACJA" />

                <Button android:id="@+id/openCityEvents" style="@style/GrimCombatButton" android:text="WIEŚCI" />
                <Button android:id="@+id/openTransfer" style="@style/GrimCombatButton" android:text="TRANSFER" />
                <Button android:id="@+id/openFinale" style="@style/GrimCombatButton" android:text="FINAŁ" android:visibility="gone" />
            </GridLayout>

            <!-- STATUS/LOG -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.8"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvLogMini"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#40000000"
                    android:padding="12dp"
                    android:text="Kroniki pękniętego świata..."
                    android:textColor="@color/grimGold" />

                <Button
                    android:id="@+id/openCombatStatus"
                    style="@style/GrimCombatButton"
                    android:layout_width="match_parent"
                    android:text="WALKA W TOKU"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- PARTY STRIP AT BOTTOM -->
        <include layout="@layout/strip_party" />

    </LinearLayout>
</FrameLayout>
