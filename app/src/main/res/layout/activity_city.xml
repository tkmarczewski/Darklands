<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBgMain">

    <!-- Premium Header Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/premium_frame_gold"
        android:padding="4dp">

        <TextView
            android:id="@+id/cityTitle"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/GrimTextHeader"
            android:gravity="center"
            android:text="MIASTO"
            android:textAllCaps="true"
            android:letterSpacing="0.1"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/GrimTextBody"
                android:text="Opis miasta..."
                android:paddingBottom="16dp"/>

            <TextView
                android:id="@+id/cityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/GrimTextMuted"
                android:paddingBottom="16dp"/>

            <Button android:id="@+id/btnTavern"
                style="@style/GrimCombatButton"
                android:text="Odwiedź Karczmę"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnChurch"
                style="@style/GrimCombatButton"
                android:text="Idź do Kościoła"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnMarket"
                style="@style/GrimCombatButton"
                android:text="Na Targ"
                android:layout_marginBottom="8dp"/>

            <Button android:id="@+id/btnRecruit"
                style="@style/GrimCombatButton"
                android:text="Zwerbuj Bohatera"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/npcListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="16dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/GrimTextHeader"
                    android:textSize="16sp"
                    android:text="MIESZKAŃCY"
                    android:paddingBottom="8dp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnExitCity"
        style="@style/GrimBackButton"
        android:text="← POWRÓT DO HUBU"/>

</LinearLayout>
