<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBgMain">

    <!-- Premium Header Area -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/premium_frame_gold"
        android:padding="4dp">

        <TextView
            android:id="@+id/tvCityName"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/GrimTextHeader"
            android:gravity="center"
            android:text="MIASTO"
            android:textAllCaps="true"
            android:letterSpacing="0.1"/>
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvCityDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/GrimTextBody"
                android:text="Opis miasta..."
                android:paddingBottom="16dp"/>

            <!-- Placeholder for city actions -->

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnBackFromCity"
        style="@style/GrimBackButton"
        android:text="← POWRÓT DO HUBU"/>

</LinearLayout>
