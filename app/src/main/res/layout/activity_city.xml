<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/ivCityBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_region_north_coast" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B0000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Compact Header -->
        <TextView
            android:id="@+id/cityTitle"
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOKACJA"
            android:gravity="center"
            android:background="#D0000000"
            android:padding="8dp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <!-- LEFT: Navigation -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:orientation="vertical">

                <Button android:id="@+id/btnTavern" style="@style/GrimNavButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/city_tavern" android:fontFamily="monospace" />
                <Button android:id="@+id/btnMarket" style="@style/GrimNavButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/city_market" android:fontFamily="monospace" />
                <Button android:id="@+id/btnChurch" style="@style/GrimNavButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/city_temple" android:fontFamily="monospace" />
                <Button android:id="@+id/btnRecruit" style="@style/GrimNavButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/city_recruit" android:fontFamily="monospace" />

                <Space android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                <Button android:id="@+id/btnExitCity" style="@style/GrimBackButton" android:layout_width="match_parent" android:text="@string/btn_back" android:fontFamily="monospace" />
            </LinearLayout>

            <!-- RIGHT: NPC List & Lore -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.6"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:id="@+id/cityStatus"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#60000000"
                    android:padding="8dp"
                    android:textColor="@color/grimGold"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:text="Miasto spowite mrokiem." />

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MIESZKAŃCY I WĘDROWCY:"
                    android:textSize="11sp"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="4dp"
                    android:background="#20FFFFFF">
                    <LinearLayout
                        android:id="@+id/npcListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="4dp" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
