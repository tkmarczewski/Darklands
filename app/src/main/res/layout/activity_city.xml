<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- REGIONAL BACKGROUND -->
    <ImageView
        android:id="@+id/ivCityBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_region_north_coast" />

    <!-- DARK OVERLAY -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header - Clean -->
        <TextView
            android:id="@+id/cityTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/GrimTextHeader"
            android:gravity="center"
            android:padding="16dp"
            android:background="#80000000" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Actions - Unified terminology -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="#60000000"
                android:padding="8dp">

                <Button android:id="@+id/btnTavern"
                    style="@style/GrimCombatButton"
                    android:text="Karczma"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="8dp" />

                <Button android:id="@+id/btnMarket"
                    style="@style/GrimCombatButton"
                    android:text="Targ"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="8dp" />

                <Button android:id="@+id/btnChurch"
                    style="@style/GrimCombatButton"
                    android:text="Kaplica"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="8dp" />

                <Button android:id="@+id/btnRecruit"
                    style="@style/GrimCombatButton"
                    android:text="Werbunek"
                    android:layout_width="match_parent"
                    android:layout_marginBottom="8dp" />

                <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />

                <Button android:id="@+id/btnExitCity"
                    style="@style/GrimBackButton"
                    android:text="← POWRÓT" />
            </LinearLayout>

            <!-- Status and NPCs -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cityStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/GrimTextBody"
                    android:background="#40000000"
                    android:padding="12dp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/grimGold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/GrimTextHeader"
                    android:textSize="14sp"
                    android:text="MIESZKAŃCY I WĘDROWCY:"
                    android:layout_marginBottom="8dp"
                    android:paddingStart="12dp"/>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <LinearLayout
                        android:id="@+id/npcListContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp" />
                </ScrollView>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
