<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/GrimTextHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="PLECAK DRUŻYNY"
        android:layout_marginBottom="12dp" />

    <!-- Hero Selector for Equipping -->
    <LinearLayout
        android:id="@+id/llHeroSelector"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:background="#20FFFFFF"
        android:padding="4dp">
        <!-- Hero buttons injected here -->
    </LinearLayout>

    <TextView
        android:id="@+id/tvActiveHeroInfo"
        style="@style/GrimTextBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Aktywny bohater: Ralwing"
        android:textColor="@color/grimAccentGold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInventory"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="4" />

    <Button
        android:id="@+id/btnBackFromInv"
        style="@style/GrimBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="← POWRÓT"
        android:layout_marginTop="12dp" />

</LinearLayout>
