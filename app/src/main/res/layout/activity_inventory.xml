<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#1a1a2e">
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/tvInventory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textColor="#c8a96e" android:textSize="13sp"/>
    </ScrollView>
    <EditText android:id="@+id/etItemIndex" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Numer przedmiotu" android:inputType="number" android:textColor="#c8a96e"/>
    <Button android:id="@+id/btnUse" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Uzyj"/>
    <TextView android:id="@+id/tvResult" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#a0e8a0" android:textSize="13sp"/>
    <Button android:id="@+id/btnExitInventory" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Zamknij plecak"/>
</LinearLayout>
