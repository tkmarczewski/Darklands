<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="24dp"
        android:baselineAligned="false">

        <!-- LEFT SIDE: NAME & ATTRIBUTES -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="12dp">

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KREACJA BOHATERA"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <!-- Restoration of EditText with fix for Handwriting overlay -->
                <!-- textNoSuggestions + textVisiblePassword usually forces standard keyboard -->
                <EditText
                    android:id="@+id/etHeroName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Wpisz imię..."
                    android:textColor="@color/grimTextPrimary"
                    android:textColorHint="@color/grimTextMuted"
                    android:backgroundTint="@color/grimAccentGold"
                    android:inputType="textNoSuggestions|textVisiblePassword"
                    android:imeOptions="actionDone"
                    android:text="Bohater" />

                <Button
                    android:id="@+id/btnRandomizeName"
                    style="@style/GrimSmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LOSUJ" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvPointsRemaining"
                    style="@style/GrimTextBody"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Punkty do rozdania: 20"
                    android:textColor="@color/grimAccentGold" />

                <Button
                    android:id="@+id/btnAutoAllocate"
                    style="@style/GrimSmallButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutStr" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutAgi" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutPer" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutInt" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutEnd" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutCha" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutPie" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT SIDE: TRAITS & START -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WYBIERZ CECHĘ"
                android:layout_marginBottom="12dp"/>

            <RadioGroup
                android:id="@+id/rgTraits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">
                <RadioButton android:id="@+id/rbTrait1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dar Mgły" android:textColor="@color/grimTextPrimary" />
                <RadioButton android:id="@+id/rbTrait2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Serce z Żelaza" android:textColor="@color/grimTextPrimary" />
                <RadioButton android:id="@+id/rbTrait3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Słoneczne Oko" android:textColor="@color/grimTextPrimary" />
            </RadioGroup>

            <TextView
                android:id="@+id/tvTraitDesc"
                style="@style/GrimTextMuted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wybierz cechę, aby zobaczyć opis."
                android:layout_marginBottom="16dp"
                android:minLines="2"/>

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECJALIZACJA (WYBIERZ 3)"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:id="@+id/llSkillSpecializations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="24dp">
            </LinearLayout>

            <Button
                android:id="@+id/btnStartGame"
                style="@style/GrimCombatButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="ROZPOCZNIJ PRZYGODĘ" />

        </LinearLayout>
    </LinearLayout>
</ScrollView>
