<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- Lewa strona: Imię i Atrybuty -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KREACJA BOHATERA"
                android:layout_marginBottom="16dp"/>

            <EditText
                android:id="@+id/etHeroName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Wpisz imię..."
                android:textColor="@color/grimTextPrimary"
                android:textColorHint="@color/grimTextMuted"
                android:backgroundTint="@color/grimAccentGold"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvPointsRemaining"
                style="@style/GrimTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Punkty do rozdania: 20"
                android:textColor="@color/grimAccentGold"
                android:layout_marginBottom="12dp"/>

            <!-- Atrybuty w układzie pionowym dla stabilności -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Siła -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutStr" />
                <!-- Zręczność -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutAgi" />
                <!-- Percepcja -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutPer" />
                <!-- Inteligencja -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutInt" />
                <!-- Wytrzymałość -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutEnd" />
                <!-- Charyzma -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutCha" />
                <!-- Pobożność -->
                <include layout="@layout/item_attribute_control" android:id="@+id/layoutPie" />

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Prawa strona: Cechy i Start -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp">

        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WYBIERZ CECHĘ"
            android:layout_marginBottom="12dp"/>

        <RadioGroup
            android:id="@+id/rgTraits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">
            <RadioButton android:id="@+id/rbTrait1" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dar Mgły" android:textColor="@color/grimTextPrimary" />
            <RadioButton android:id="@+id/rbTrait2" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Serce z Żelaza" android:textColor="@color/grimTextPrimary" />
            <RadioButton android:id="@+id/rbTrait3" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Słoneczne Oko" android:textColor="@color/grimTextPrimary" />
        </RadioGroup>

        <TextView
            android:id="@+id/tvTraitDesc"
            style="@style/GrimTextMuted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Wybierz cechę, aby zobaczyć opis."
            android:layout_marginBottom="16dp"
            android:minLines="2"/>

        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SPECJALIZACJA (WYBIERZ 3)"
            android:layout_marginBottom="8dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:id="@+id/llSkillSpecializations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <!-- Checkboxy będą dodane programowo lub statycznie -->
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnStartGame"
            style="@style/GrimCombatButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ROZPOCZNIJ PRZYGODĘ" />

    </LinearLayout>

</LinearLayout>
