<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KREACJA KOTWICY"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- NAME -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etName"
                style="@style/GrimTextBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Imię bohatera"
                android:inputType="textNoSuggestions|textVisiblePassword"
                android:importantForAutofill="no"
                android:backgroundTint="@color/grimGold" />
            <Button
                android:id="@+id/btnRandomizeName"
                style="@style/GrimSmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOSUJ" />
        </LinearLayout>

        <!-- CAREER SELECTION -->
        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PROFESJA"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgCareers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            <RadioButton android:id="@+id/rbKnight" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="RYCERZ" android:textColor="@color/grimTextPrimary" />
            <RadioButton android:id="@+id/rbAlchemist" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ALCHEMIK" android:textColor="@color/grimTextPrimary" />
            <RadioButton android:id="@+id/rbRanger" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ŁOWCA" android:textColor="@color/grimTextPrimary" />
            <RadioButton android:id="@+id/rbMage" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MAG" android:textColor="@color/grimTextPrimary" />
        </RadioGroup>

        <!-- ATTRIBUTES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <TextView
                android:id="@+id/tvPointsRemaining"
                style="@style/GrimTextBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Punkty: 20" />
            <Button
                android:id="@+id/btnAutoAllocate"
                style="@style/GrimSmallButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AUTO" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp">
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutStr" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutAgi" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutPer" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutInt" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutEnd" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutCha" />
            <include layout="@layout/item_attribute_control" android:id="@+id/layoutPie" />
        </LinearLayout>

        <!-- SPECIALIZATIONS -->
        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SPECJALIZACJA (WYBIERZ 3)"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/llSkillSpecializations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnStartGame"
            style="@style/GrimNavButton"
            android:layout_width="match_parent"
            android:text="ROZPOCZNIJ PRZYGODĘ" />

    </LinearLayout>
</ScrollView>
