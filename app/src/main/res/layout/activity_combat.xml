<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBg">

    <!-- NAGŁÓWEK WALKI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A0000"
        android:padding="8dp"
        android:orientation="horizontal">

        <TextView android:id="@+id/tvCombatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⚔ WALKA"
            android:textColor="@color/grimBlood"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView android:id="@+id/tvCombatRound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Runda 1"
            android:textColor="@color/grimParchment"
            android:textSize="13sp"/>
    </LinearLayout>

    <!-- LISTA WROGÓW -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEnemies"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <!-- LOG WALKI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#0A0000"
        android:padding="8dp">

        <TextView android:id="@+id/tvCombatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/grimParchment"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:text="> Wrogowie atakują z mroku..."/>
    </ScrollView>

    <!-- PANEL AKCJI WALKI -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:background="@color/grimBgDark"
        android:padding="4dp">

        <Button android:id="@+id/btnAttack"
            style="@style/GrimCombatButton"
            android:text="⚔ Atak"
            android:backgroundTint="@color/grimBlood"
            android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnDefend"
            style="@style/GrimCombatButton"
            android:text="🛡 Obrona"
            android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnFlee"
            style="@style/GrimCombatButton"
            android:text="💨 Ucieczka"
            android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnUseMist"
            style="@style/GrimCombatButton"
            android:text="☁ Mgła"
            android:backgroundTint="@color/grimMist"
            android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnUseBlood"
            style="@style/GrimCombatButton"
            android:text="🩸 Krew"
            android:backgroundTint="@color/grimBlood"
            android:layout_columnWeight="1"/>

        <Button android:id="@+id/btnUseReflection"
            style="@style/GrimCombatButton"
            android:text="🪞 Odbicie"
            android:backgroundTint="@color/grimReflection"
            android:layout_columnWeight="1"/>

    </GridLayout>

    <!-- PARTY STRIP -->
    <include layout="@layout/strip_party"/>

</LinearLayout>
