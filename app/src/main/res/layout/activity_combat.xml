<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvCombatTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WALKA"
        android:textColor="#e63946"
        android:textSize="20sp"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/heroStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#c8a96e"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <TextView
            android:id="@+id/enemyStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#e63946"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:gravity="end" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="#16213e">
        <TextView
            android:id="@+id/combatLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textColor="#ffffff"
            android:textSize="11sp"
            android:fontFamily="monospace" />
    </ScrollView>

    <TextView
        android:id="@+id/tvSkillsTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="UMIEJĘTNOŚCI"
        android:textColor="#c8a96e"
        android:textSize="12sp"
        android:layout_marginTop="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/skillsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <Button
        android:id="@+id/btnAttack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zwykły Atak"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnExitCombat"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Odejdź z pola walki"
        android:layout_marginTop="8dp" />

</LinearLayout>
