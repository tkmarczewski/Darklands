<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REKRUTACJA NAJEMNIKÓW"
            android:gravity="center"
            android:fontFamily="monospace"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvRecruitStatus"
            style="@style/GrimTextBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="W karczmie siedzi kilku śmiałków..."
            android:gravity="center"
            android:fontFamily="monospace"
            android:layout_marginBottom="24dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:id="@+id/recruitListContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <Button
            android:id="@+id/btnExitRecruit"
            style="@style/GrimBackButton"
            android:layout_width="match_parent"
            android:text="← POWRÓT"
            android:fontFamily="monospace" />

    </LinearLayout>
</FrameLayout>
