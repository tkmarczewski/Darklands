<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- THE WORLD MAP BACKGROUND -->
    <ImageView
        android:id="@+id/ivWorldMap"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_world_map" />

    <!-- DARK GRADIENT OVERLAY FOR BETTER CONTRAST -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000" />

    <!-- INTERACTIVE HOTSPOTS -->
    <RelativeLayout
        android:id="@+id/mapOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 1. Wybrzeże Północne (Top Left) -->
        <Button
            android:id="@+id/point_north_coast"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_marginTop="80dp"
            android:layout_marginStart="80dp"
            android:text="Wybrzeże\nPółnocne"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 2. Równiny Koronne (Top Right) -->
        <Button
            android:id="@+id/point_crown_plains"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="80dp"
            android:layout_marginEnd="80dp"
            android:text="Równiny\nKoronne"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 3. Serce Krainy (Center) -->
        <Button
            android:id="@+id/point_heartland"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_centerInParent="true"
            android:text="Serce\nKrainy"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 4. Pogranicze Stepowe (Left Center) -->
        <Button
            android:id="@+id/point_steppe"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="40dp"
            android:text="Pogranicze\nStepowe"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 5. Południowe Ruiny (Bottom Right) -->
        <Button
            android:id="@+id/point_south_ruins"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="100dp"
            android:layout_marginEnd="80dp"
            android:text="Południowe\nRuiny"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 6. Góry Południowe (Bottom Center) -->
        <Button
            android:id="@+id/point_south_mountains"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="120dp"
            android:text="Góry\nPołudniowe"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <!-- 7. Ziemie Dzikie (Center Right) -->
        <Button
            android:id="@+id/point_wild_lands"
            android:layout_width="160dp"
            android:layout_height="60dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="40dp"
            android:text="Ziemie\nDzikie"
            android:backgroundTint="#AA000000"
            android:textColor="@color/grimGold"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

    </RelativeLayout>

    <!-- BACK BUTTON -->
    <Button
        android:id="@+id/btnExitAtlas"
        style="@style/GrimBackButton"
        android:layout_gravity="bottom"
        android:text="← POWRÓT" />

</FrameLayout>
