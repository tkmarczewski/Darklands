<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvEquipTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="EKWIPUNEK BOHATERA"
        android:textColor="#c8a96e"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Weapon Slot -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/ivWeaponSlot"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_equipment_sword"
                android:background="#16213e"
                android:padding="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BROŃ"
                android:textColor="#c8a96e"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Body Armor Slot -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp">
            <ImageView
                android:id="@+id/ivArmorSlot"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_equipment_armor"
                android:background="#16213e"
                android:padding="8dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ZBROJA"
                android:textColor="#c8a96e"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvEquipmentStats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#c8a96e"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        android:fontFamily="monospace" />

    <Button
        android:id="@+id/btnBackEquip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Powrót"
        android:layout_marginTop="24dp" />

</LinearLayout>
