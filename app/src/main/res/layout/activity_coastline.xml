<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a2e"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WYBRZEŻE"
        android:textColor="#c8a96e"
        android:textSize="22sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvCoastlineDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#AAAAAA"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnTalkToAelion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Porozmawiaj z Aelionem"
        android:layout_marginBottom="12dp"
        style="@style/GrimNavButton" />

    <Button
        android:id="@+id/btnExploreCoastline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Zbadaj linię brzegową"
        android:layout_marginBottom="12dp"
        style="@style/GrimNavButton" />

    <Button
        android:id="@+id/btnExitCoastline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="POWRÓT"
        android:layout_marginTop="16dp"
        style="@style/GrimBackButton" />

</LinearLayout>
