<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/GrimTextHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="KARTA BOHATERA"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Kolumna lewa: Portret i Główne Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivPortrait"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:src="@drawable/ic_stats_cha"
                android:scaleType="centerInside"
                android:background="@color/grimBgDarker"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/tvHeroName"
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="IMIĘ" />

            <TextView
                android:id="@+id/tvHeroLevel"
                style="@style/GrimTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Poziom 1"
                android:textColor="@color/grimAccentGold" />

            <Space android:layout_width="match_parent" android:layout_height="16dp" />

            <TextView
                android:id="@+id/tvHpStatus"
                style="@style/GrimTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HP: 30/30" />
            <ProgressBar
                android:id="@+id/pbHp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="100"
                android:progressTint="@color/grimCombatDmg"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSanityStatus"
                style="@style/GrimTextBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poczytalność: 100%" />
            <ProgressBar
                android:id="@+id/pbSanity"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="100"
                android:progressTint="#3F51B5"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

        <!-- Kolumna środkowa: Atrybuty -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATRYBUTY"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:alignmentMode="alignMargins">

                <include layout="@layout/item_attribute_display" android:id="@+id/viewStr" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewAgi" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewPer" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewInt" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewEnd" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewCha" />
                <include layout="@layout/item_attribute_display" android:id="@+id/viewPie" />

            </GridLayout>

        </LinearLayout>

        <!-- Kolumna prawa: Cechy i Zdolności -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.5"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CECHA"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvTrait"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Brak cechy"
                    android:textColor="@color/grimAccentGold"
                    android:layout_marginBottom="16dp" />

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZDOLNOŚCI"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvAbilities"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Brak zdolności"
                    android:layout_marginBottom="16dp" />

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UMIEJĘTNOŚCI"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvSkills"
                    style="@style/GrimTextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="..." />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <Button
        android:id="@+id/btnBackFromChar"
        style="@style/GrimBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="← POWRÓT"
        android:layout_marginTop="8dp" />

</LinearLayout>
