<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- THEMED BACKGROUND -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_party_castle" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B0000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- HEADER -->
        <TextView
            android:id="@+id/tvHeroTitle"
            style="@style/GrimTextHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KARTA BOHATERA"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/ui_frame_gold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- LEFT: PORTRAIT & VITALS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/ui_panel_main"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivHeroPortrait"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:src="@drawable/port_knight"
                    android:scaleType="centerInside"
                    android:background="@drawable/ui_frame_portrait"
                    android:padding="8dp" />

                <TextView
                    android:id="@+id/tvHeroName"
                    style="@style/GrimTextHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvHeroRole"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/grimGold" />

                <Space android:layout_width="match_parent" android:layout_height="16dp" />

                <TextView style="@style/GrimTextSmall" android:text="ŻYWOTNOŚĆ" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ProgressBar
                    android:id="@+id/pbHeroHP"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="80"
                    android:progressTint="#FF0000" />

                <TextView style="@style/GrimTextSmall" android:text="POCZYTALNOŚĆ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" />
                <ProgressBar
                    android:id="@+id/pbHeroSanity"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progress="60"
                    android:progressTint="#00AAFF" />
            </LinearLayout>

            <!-- CENTER: STATS PANEL -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="16dp">

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="ATRYBUTY"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp" />

                <GridLayout
                    android:id="@+id/glStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:background="@drawable/ui_panel_stats"
                    android:padding="16dp">
                    <!-- Dynamic stats populated in Kotlin -->
                </GridLayout>
            </LinearLayout>

            <!-- RIGHT: BIOGRAPHY & LORE -->
            <ScrollView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:paddingStart="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/ui_panel_side"
                    android:padding="12dp">

                    <TextView style="@style/GrimTextHeader" android:text="HISTORIA" android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvHeroBio"
                        style="@style/GrimTextBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Urodzony pod znakiem Pęknięcia..." />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>

        <Button
            android:id="@+id/btnExitCharacter"
            style="@style/GrimBackButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="POWRÓT" />

    </LinearLayout>
</FrameLayout>
