<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/grimBgMain"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        style="@style/GrimTextHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="KARTA BOHATERA"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Kolumna lewa: Portret i Podstawy -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/ivPortrait"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center_horizontal"
                android:scaleType="centerCrop"
                android:src="@drawable/port_knight"
                android:background="#20FFFFFF"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvHeroName"
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="ELARA SHADOW" />

            <TextView
                android:id="@+id/tvHeroLevel"
                style="@style/GrimTextBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="Poziom 1"
                android:textColor="@color/grimAccentGold" />

            <Space android:layout_width="match_parent" android:layout_height="12dp" />

            <TextView
                android:id="@+id/tvHpStatus"
                style="@style/GrimTextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HP: 30/30" />
            <ProgressBar
                android:id="@+id/pbHp"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progressTint="@color/grimBlood"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvSanityStatus"
                style="@style/GrimTextSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Poczytalność: 100%" />
            <ProgressBar
                android:id="@+id/pbSanity"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progressTint="@color/grimMist" />
        </LinearLayout>

        <!-- Kolumna środkowa: Atrybuty i Wyposażenie -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ATRYBUTY"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="true">
                <!-- Atrybuty renderowane dynamicznie lub przez include bez ikon (usuniete) -->
                <TextView android:id="@+id/tvStatStr" style="@style/GrimTextBody" android:text="Siła: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatAgi" style="@style/GrimTextBody" android:text="Zręczność: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatPer" style="@style/GrimTextBody" android:text="Percepcja: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatInt" style="@style/GrimTextBody" android:text="Inteligencja: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatEnd" style="@style/GrimTextBody" android:text="Wytrzymałość: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatCha" style="@style/GrimTextBody" android:text="Charyzma: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvStatPie" style="@style/GrimTextBody" android:text="Pobożność: 10" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </GridLayout>

            <Space android:layout_width="match_parent" android:layout_height="16dp" />

            <TextView
                style="@style/GrimTextHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WYPOSAŻENIE"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#20FFFFFF"
                android:padding="8dp">
                <TextView android:id="@+id/tvEquippedWeapon" style="@style/GrimTextSmall" android:text="Broń: Brak" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvEquippedArmor" style="@style/GrimTextSmall" android:text="Pancerz: Brak" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <TextView android:id="@+id/tvEquippedAcc" style="@style/GrimTextSmall" android:text="Akcesoria: Brak" android:layout_width="match_parent" android:layout_height="wrap_content" />
            </LinearLayout>

        </LinearLayout>

        <!-- Kolumna prawa: Cechy i Zdolności -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:paddingStart="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CECHA"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvTrait"
                    style="@style/GrimTextBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Brak cechy"
                    android:textColor="@color/grimAccentGold"
                    android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ZDOLNOŚCI"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvAbilities"
                    style="@style/GrimTextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Brak zdolności"
                    android:layout_marginBottom="12dp" />

                <TextView
                    style="@style/GrimTextHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="UMIEJĘTNOŚCI"
                    android:textSize="14sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:id="@+id/tvSkills"
                    style="@style/GrimTextSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="..." />

            </LinearLayout>
        </ScrollView>

    </LinearLayout>

    <Button
        android:id="@+id/btnBackFromChar"
        style="@style/GrimBackButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="← POWRÓT"
        android:layout_marginTop="8dp" />

</LinearLayout>
