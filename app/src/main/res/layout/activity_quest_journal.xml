<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBgMain"
    android:padding="16dp">

    <!-- HEADER - NO FRAME -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="#80000000"
        android:padding="8dp">

        <Button
            android:id="@+id/btnExitJournal"
            style="@style/GrimSmallButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← POWRÓT" />

        <TextView
            style="@style/GrimTextHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="KRONIKI ŚWIATA" />
    </RelativeLayout>

    <!-- TABS -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">
        <Button
            android:id="@+id/tabAvailable"
            style="@style/GrimSmallButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="DOSTĘPNE" />
        <Button
            android:id="@+id/tabActive"
            style="@style/GrimSmallButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AKTYWNE" />
        <Button
            android:id="@+id/tabCompleted"
            style="@style/GrimSmallButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="ZAKOŃCZONE" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#40000000"
        android:padding="16dp">
        <LinearLayout
            android:id="@+id/questListContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

</LinearLayout>
