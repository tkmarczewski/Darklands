<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grimBg">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DRUŻYNA"
        android:textColor="@color/grimGold"
        android:fontFamily="monospace"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="12dp"
        android:background="@color/grimBgDark"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvParty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"/>

    <Button android:id="@+id/btnBackFromParty"
        style="@style/GrimBackButton"
        android:text="← Wróć"/>

</LinearLayout>
