<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GrimReich" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/grimBgMain</item>
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="colorPrimary">@color/grimBgMain</item>
        <item name="colorPrimaryDark">@color/grimBgUltraDark</item>
        <item name="colorAccent">@color/grimAccentGold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!-- UI Panels -->
    <style name="GrimPanelMain">
        <item name="android:background">@color/grimBgMain</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="GrimPanelSide">
        <item name="android:background">@color/grimBgSide</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="GrimPanelDialog">
        <item name="android:background">@color/grimBgUltraDark</item>
        <item name="android:padding">12dp</item>
    </style>

    <!-- Typography -->
    <style name="GrimTextHeader">
        <item name="android:textColor">@color/grimAccentGold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="GrimTextBody">
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <style name="GrimTextMuted">
        <item name="android:textColor">@color/grimTextMuted</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

    <!-- Buttons -->
    <style name="GrimNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">72dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
    </style>

    <style name="GrimRegionButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:background">@drawable/btn_region_bg</item>
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:paddingStart">16dp</item>
    </style>

    <style name="GrimCombatButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GrimSmallButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">4dp</item>
        <item name="android:background">@drawable/btn_nav_bg</item>
        <item name="android:textColor">@color/grimTextPrimary</item>
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="GrimBackButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@color/grimBgUltraDark</item>
        <item name="android:textColor">@color/grimAccentGold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GrimTextSmall">
        <item name="android:textColor">@color/grimTextSecondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">serif</item>
    </style>

</resources>
