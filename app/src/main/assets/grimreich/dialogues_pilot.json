        "text": "Nie teraz.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "fortress_guard_start",
    "npcId": "guard",
    "text": "Stój! Twierdza Żelazna nie przyjmuje uchodźców. Tylko ci z uprawnieniami lub sprawami do Dowódcy mogą przejść przez bramę.",
