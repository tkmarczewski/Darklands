  {
    "id": "aelion_meta_end",
    "npcId": "aelion",
    "text": "Strach jest tylko reakcją na prawdę. Szukaj Kotwicy, ona utrzyma ten sen w ryzach... jeszcze przez chwilę.",
    "choices": [
      {
        "text": "Będę pamiętać.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "aelion_quest",
    "npcId": "aelion",
    "text": "Relikwie są fragmentami poprzednich snów. Jeśli chcesz pomóc v stabilizacji, musisz odnaleźć Kotwicę Północy. Strażnik przy bramie wie więcej o pęknięciach v okolicy.",
    "choices": [
      {
        "text": "Pójdę do Strażnika.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "mystic_start",
    "npcId": "mystic",
