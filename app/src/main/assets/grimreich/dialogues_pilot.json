        "triggerEvent": "ACTIVATE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_start",
    "npcId": "deserter",
    "text": "Nie zbliżaj się! Widziałem jak niebo mrugało... Widziałem liczby pod chmurami! Jesteśmy błędem!",
    "choices": [
      {
        "text": "Milcz i wracaj do posterunku albo zginiesz!",
        "targetNodeId": "deserter_obey",
        "requiredAttributes": { "strength": 14 }
      },
      {
        "text": "Powiedz mi o tym Szyfrze. Co dokładnie widziałeś?",
        "targetNodeId": "deserter_truth",
        "requiredAttributes": { "intelligence": 15 }
      },
      {
        "text": "Jesteś niebezpieczny. Muszę cię uciszyć (WALKA).",
