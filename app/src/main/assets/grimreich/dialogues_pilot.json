        "isCombatTrigger": true,
        "triggerEvent": "ADVANCE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_obey",
    "npcId": "deserter",
    "text": "Dobrze, dobrze! Nie krzycz... Wrócę. Ale wy i tak nie rozumiecie...",
