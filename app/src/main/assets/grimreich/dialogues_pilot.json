  {
    "id": "aelion_start",
    "npcId": "aelion",
    "text": "Kotwico... Twoja obecność tutaj jest jak pęknięcie na tafli jeziora. Czy wiesz, że ten świat jest tylko snem Sędziów?",
    "choices": [
      {
        "text": "[INTELIGENCJA] Jeśli to sen, kto nas śni?",
        "targetNodeId": "aelion_meta",
        "requiredAttributes": { "intelligence": 16 }
      },
      {
        "text": "Szukam relikwii.",
        "targetNodeId": "aelion_quest"
      },
      {
        "text": "Muszę iść.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "aelion_meta",
    "npcId": "aelion",
    "text": "Śnią nas Skrybowie Absolutni. Każdy twój krok, każda walka, to tylko linia w ich Kronice. Czy czujesz, jak stabilność świata drży, gdy o tym mówię?",
    "choices": [
      {
        "text": "To przerażające.",
        "targetNodeId": "aelion_meta_end"
      },
      {
        "text": "Nie wierzę w to.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "aelion_meta_end",
    "npcId": "aelion",
    "text": "Strach jest tylko reakcją na prawdę. Szukaj Kotwicy, ona utrzyma ten sen w ryzach... jeszcze przez chwilę.",
    "choices": [
      {
        "text": "Będę pamiętać.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "aelion_quest",
    "npcId": "aelion",
    "text": "Relikwie są fragmentami poprzednich snów. Jeśli chcesz pomóc w stabilizacji, musisz odnaleźć Kotwicę Północy. Strażnik przy bramie wie więcej o pęknięciach w okolicy.",
    "choices": [
      {
        "text": "Pójdę do Strażnika.",
        "targetNodeId": "end"
      }
    ]
  },
