        "requiredQuestId": "q_coast_harvest",
        "requiredQuestStatus": "objective_met"
      },
      {
        "text": "Pokaż mi swoje towary.",
        "targetNodeId": "end",
        "triggerEvent": "open_market"
      },
      {
        "text": "O jakich zbiorach mówisz?",
        "targetNodeId": "merchant_quest_check",
        "requiredQuestId": "q_coast_harvest",
        "requiredQuestStatus": "available"
      },
      {
        "text": "Tylko się rozglądam.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "merchant_quest_check",
    "npcId": "merchant",
    "text": "Archiwiści potrzebują rzadkich ziół z mgły. Płacę dobrze, jeśli przyniesiesz mi ich wystarczająco dużo.",
