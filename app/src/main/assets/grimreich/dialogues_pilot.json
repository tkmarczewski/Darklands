  {
    "id": "noble_start",
    "npcId": "noble",
    "text": "Moje dziedzictwo pęka jak sucha gałąź. Odzyskaj to, co należy do mojego rodu, zanim nicość to pochłonie.",
    "choices": [
      { "text": "Uczynię to dla nagrody.", "targetNodeId": "end", "triggerEvent": "activate_quest", "triggerValue": "active" },
