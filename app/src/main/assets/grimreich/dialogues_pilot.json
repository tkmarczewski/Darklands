[
  {
    "id": "guard_start",
    "npcId": "guard",
    "text": "Stój! Mgła gęstnieje, a prawo musi być przestrzegane. Czego szukasz w cieniu murów?",
    "choices": [
      {
        "text": "[ZADANIE] Melduję wykonanie wyroku (Wyrok Inkwizycji).",
        "targetNodeId": "guard_verdict_done",
        "triggerEvent": "QUEST_OBJECTIVE_MET",
        "triggerValue": "q_verdict_1"
      },
      {
        "text": "[ZADANIE] Czy coś niepokojącego działo się ostatnio?",
        "targetNodeId": "guard_quest_check"
      },
      {
        "text": "[CHARYZMA] Wyglądasz na zmęczonego. Odpocznij chwilę.",
        "targetNodeId": "guard_relaxed",
        "requiredAttributes": { "charisma": 12 }
      },
      {
        "text": "Tylko przechodzę.",
        "targetNodeId": "end"
      }
    ]
  },
  {
    "id": "guard_relaxed",
    "npcId": "guard",
    "text": "Dziękuję... rzadko kto tutaj dostrzega w nas ludzi. Jeśli chcesz pomóc, idź do Portu. Tam błąka się dezerter.",
    "choices": [
      {
        "text": "Sprawdzę to (ZADANIE: Dezerter).",
        "targetNodeId": "end",
        "triggerEvent": "ACTIVATE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_start",
    "npcId": "deserter",
    "text": "Nie zbliżaj się! Widziałem jak niebo mrugało... Widziałem liczby pod chmurami! Jesteśmy błędem!",
    "choices": [
      {
        "text": "[SIŁA] Milcz i wracaj do posterunku albo zginiesz!",
        "targetNodeId": "deserter_obey",
        "requiredAttributes": { "strength": 14 }
      },
      {
        "text": "[INTELIGENCJA] Powiedz mi o tym Szyfrze. Co dokładnie widziałeś?",
        "targetNodeId": "deserter_truth",
        "requiredAttributes": { "intelligence": 15 }
      },
      {
        "text": "Jesteś niebezpieczny. Muszę cię uciszyć (WALKA).",
        "targetNodeId": "end",
        "isCombatTrigger": true,
        "triggerEvent": "ADVANCE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_obey",
    "npcId": "deserter",
    "text": "Dobrze, dobrze! Nie krzycz... Wrócę. Ale wy i tak nie rozumiecie...",
    "choices": [
      {
        "text": "Wracaj (ZAKOŃCZ ZADANIE).",
        "targetNodeId": "end",
        "triggerEvent": "ADVANCE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_truth",
    "npcId": "deserter",
    "text": "Widziałem Szyfr... #000000... Wyraz 'NULL' wyryty w słońcu. Odchodzę do Miejsca Pomiędzy.",
    "choices": [
      {
        "text": "Pozwól mu odejść (ZYSKAJ WIEDZĘ).",
