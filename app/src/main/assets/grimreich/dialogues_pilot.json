        "targetNodeId": "end",
        "triggerEvent": "ADVANCE_QUEST",
        "triggerValue": "q_deserter"
      }
    ]
  },
  {
    "id": "deserter_truth",
    "npcId": "deserter",
    "text": "Widziałem Szyfr... #000000... Wyraz 'NULL' wyryty w słońcu. Odchodzę do Miejsca Pomiędzy.",
